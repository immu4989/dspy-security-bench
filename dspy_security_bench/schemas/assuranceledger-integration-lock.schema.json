{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-integration-lock.schema.json",
  "title": "AssuranceLedger IntegrationLock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "source_manifest_sha256", "required_schemas", "required_protocols", "summary", "claim_boundary", "limitations", "lock_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AssuranceLedger IntegrationLock / Owner-pinned capability baseline"},
    "protocol_version": {"const": "assuranceledger-integration-lock-v1"},
    "source_manifest_sha256": {"$ref": "#/$defs/digest"},
    "required_schemas": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^assuranceledger-[a-z0-9-]+\\.schema\\.json$"}, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "required_protocols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/protocol"}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["required_schema_count", "required_protocol_count", "automatic_actions"], "properties": {"required_schema_count": {"type": "integer", "minimum": 1}, "required_protocol_count": {"type": "integer", "minimum": 1}, "automatic_actions": {"const": 0}}},
    "claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lock_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "report_type", "artifact_schemas", "verifier_command", "standalone_verification", "evidence_root_required", "network_required", "automatic_actions", "embedded_data_classes", "artifact_schema_sha256"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "report_type": {"type": "string", "minLength": 1},
        "artifact_schemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "verifier_command": {"type": "string", "pattern": "^ledger verify"},
        "standalone_verification": {"type": "boolean"},
        "evidence_root_required": {"type": "boolean"},
        "network_required": {"type": "boolean"},
        "automatic_actions": {"type": "integer", "minimum": 0},
        "embedded_data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "artifact_schema_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
