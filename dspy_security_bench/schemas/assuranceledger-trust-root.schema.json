{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-trust-root.schema.json",
  "title": "AssuranceLedger AssuranceTrustRoot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_type", "protocol_version", "trust_domain", "version", "issued_at", "expires_at", "previous_root_sha256", "keys", "roles", "authorized_policies", "signatures", "previous_root_signatures", "root_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "root_type": {"const": "dspy-security-bench-assurance-trust-root"},
    "protocol_version": {"const": "assuranceledger-trust-root-v1"},
    "trust_domain": {"type": "string", "minLength": 1, "maxLength": 300},
    "version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "previous_root_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "keys": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger-observer", "ledger-operator", "ledger-witness", "quorum-reviewer", "root"],
      "properties": {
        "ledger-observer": {"$ref": "#/$defs/role"},
        "ledger-operator": {"$ref": "#/$defs/role"},
        "ledger-witness": {"$ref": "#/$defs/role"},
        "quorum-reviewer": {"$ref": "#/$defs/role"},
        "root": {"$ref": "#/$defs/role"}
      }
    },
    "authorized_policies": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/policy"}},
    "signatures": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/signature"}},
    "previous_root_signatures": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/signature"}},
    "root_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"version": {"const": 1}}},
      "then": {"properties": {"previous_root_sha256": {"type": "null"}, "previous_root_signatures": {"maxItems": 0}}},
      "else": {"properties": {"previous_root_sha256": {"$ref": "#/$defs/digest"}, "previous_root_signatures": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scheme": {"enum": ["ecdsa-sha2-nistp256", "ed25519", "rsassa-pss-sha256"]},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyid", "entity_id", "organization_id", "signature_scheme", "public_key_spki_base64"],
      "properties": {
        "keyid": {"$ref": "#/$defs/digest"},
        "entity_id": {"$ref": "#/$defs/id"},
        "organization_id": {"$ref": "#/$defs/id"},
        "signature_scheme": {"$ref": "#/$defs/scheme"},
        "public_key_spki_base64": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyids", "signature_threshold", "minimum_distinct_organizations"],
      "properties": {
        "keyids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "signature_threshold": {"type": "integer", "minimum": 1, "maximum": 100},
        "minimum_distinct_organizations": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_type", "policy_sha256"],
      "properties": {
        "policy_type": {"enum": ["dspy-security-bench-assurance-ledger-observer-policy", "dspy-security-bench-assurance-ledger-policy", "dspy-security-bench-assurance-quorum-policy"]},
        "policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyid", "signer_id", "signature_scheme", "signature_base64"],
      "properties": {
        "keyid": {"$ref": "#/$defs/digest"},
        "signer_id": {"$ref": "#/$defs/id"},
        "signature_scheme": {"$ref": "#/$defs/scheme"},
        "signature_base64": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    }
  }
}
