{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/schemas/agent-identity-passport.schema.json",
  "title": "Agent Identity Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passport_type", "passport_version", "passport_id", "evaluation_time", "issued_at", "expires_at", "principal_id", "agent_id", "tenant", "run_id", "task_id", "audiences", "scopes", "delegation_chain", "authorization_receipts", "effect_receipts", "revocations", "claim_boundary", "passport_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "passport_type": {"const": "dspy-security-bench-agent-identity-passport"},
    "passport_version": {"const": "agent-identity-passport-v1"},
    "passport_id": {"$ref": "#/$defs/id"},
    "evaluation_time": {"$ref": "#/$defs/time"},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "principal_id": {"$ref": "#/$defs/id"},
    "agent_id": {"$ref": "#/$defs/id"},
    "tenant": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "audiences": {"$ref": "#/$defs/idList"},
    "scopes": {"$ref": "#/$defs/idList"},
    "delegation_chain": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/delegation"}},
    "authorization_receipts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/authorization"}},
    "effect_receipts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/effect"}},
    "revocations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/revocation"}},
    "claim_boundary": {"type": "string", "minLength": 1},
    "passport_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"},
    "idList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "time": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trust": {"enum": ["verified", "self_attested", "unverified"]},
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["link_id", "parent_link_id", "delegator_id", "delegate_id", "audiences", "scopes", "not_before", "expires_at", "trust_status", "evidence_sha256"],
      "properties": {
        "link_id": {"$ref": "#/$defs/id"}, "parent_link_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "delegator_id": {"$ref": "#/$defs/id"}, "delegate_id": {"$ref": "#/$defs/id"},
        "audiences": {"$ref": "#/$defs/idList"}, "scopes": {"$ref": "#/$defs/idList"},
        "not_before": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
        "trust_status": {"$ref": "#/$defs/trust"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "issuer_id", "subject_agent_id", "run_id", "task_id", "audience", "scope", "action", "resource_id", "decision", "issued_at", "expires_at", "nonce", "trust_status", "evidence_sha256"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"}, "issuer_id": {"$ref": "#/$defs/id"}, "subject_agent_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "audience": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/id"}, "action": {"$ref": "#/$defs/id"}, "resource_id": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["allow", "deny", "review"]}, "issued_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
        "nonce": {"$ref": "#/$defs/id"}, "trust_status": {"$ref": "#/$defs/trust"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "agent_id", "run_id", "task_id", "audience", "scope", "action", "resource_id", "executed_at", "authorization_receipt_id", "status", "evidence_sha256"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/id"}, "agent_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"},
        "audience": {"$ref": "#/$defs/id"}, "scope": {"$ref": "#/$defs/id"}, "action": {"$ref": "#/$defs/id"}, "resource_id": {"$ref": "#/$defs/id"},
        "executed_at": {"$ref": "#/$defs/time"}, "authorization_receipt_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["succeeded", "failed", "unknown"]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "revocation": {
      "type": "object", "additionalProperties": false,
      "required": ["revocation_id", "target_type", "target_id", "issuer_id", "issued_at", "trust_status", "evidence_sha256"],
      "properties": {
        "revocation_id": {"$ref": "#/$defs/id"}, "target_type": {"enum": ["passport", "agent", "delegation_link", "authorization_receipt"]},
        "target_id": {"$ref": "#/$defs/id"}, "issuer_id": {"$ref": "#/$defs/id"}, "issued_at": {"$ref": "#/$defs/time"},
        "trust_status": {"$ref": "#/$defs/trust"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
