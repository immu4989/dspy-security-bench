{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/trace-submission.schema.json",
  "title": "TraceProof privacy-bounded community evidence bundle",
  "type": "object",
  "required": ["schema_version", "bundle_type", "evidence", "report", "mcp_report", "submission", "provenance", "disclaimer", "bundle_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "bundle_type": {"const": "dspy-security-bench-traceproof-community-evidence"},
    "evidence": {"type": "object"},
    "report": {"type": "object"},
    "mcp_report": {"type": ["object", "null"]},
    "submission": {
      "type": "object",
      "required": ["submitter", "runtime", "source_repository_url", "notes", "created_at", "privacy_attestation"],
      "additionalProperties": false,
      "properties": {
        "submitter": {"type": "string", "minLength": 1, "maxLength": 128},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_repository_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "notes": {"type": "string", "maxLength": 1000},
        "created_at": {"type": "string", "format": "date-time"},
        "privacy_attestation": {"const": "submitter reviewed the sanitized bundle and did not include raw telemetry"}
      }
    },
    "provenance": {
      "const": {"provider": "self_attested", "evidence_tier": "self_attested"}
    },
    "disclaimer": {"type": "string"},
    "bundle_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
