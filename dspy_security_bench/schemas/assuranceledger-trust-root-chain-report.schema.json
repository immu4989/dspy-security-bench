{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-trust-root-chain-report.schema.json",
  "title": "AssuranceLedger AssuranceTrustRootChain v1 verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "analyzer", "evaluation_time", "anchor", "trusted_root", "root_inputs", "policy_inputs", "root_results", "transitions", "policy_results", "chain_errors", "summary", "claim_boundary", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AssuranceLedger TrustRootChain / Multi-hop trust-anchor continuity evidence"},
    "protocol_version": {"const": "assuranceledger-trust-root-chain-v1"},
    "analyzer": {"const": "deterministic-multihop-trust-root-analyzer-v1"},
    "evaluation_time": {"type": "integer", "minimum": 0},
    "anchor": {"$ref": "#/$defs/anchor"},
    "trusted_root": {"oneOf": [{"$ref": "assuranceledger-trust-root.schema.json"}, {"type": "null"}]},
    "root_inputs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "assuranceledger-trust-root.schema.json"}},
    "policy_inputs": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "root_results": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/rootResult"}},
    "transitions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/transition"}},
    "policy_results": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/policyResult"}},
    "chain_errors": {"type": "array", "maxItems": 1000, "items": {"type": "string"}},
    "summary": {"$ref": "#/$defs/summary"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "nullableInteger": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "errors": {"type": "array", "maxItems": 500, "items": {"type": "string"}},
    "scheme": {"enum": ["ecdsa-sha2-nistp256", "ed25519", "rsassa-pss-sha256"]},
    "schemeArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/scheme"}},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expected_root_sha256", "expected_trust_domain", "minimum_final_version", "anchor_source_errors", "anchor_errors", "expired_at_evaluation"],
      "properties": {
        "mode": {"enum": ["none", "pinned-root-digest", "trusted-root"]},
        "expected_root_sha256": {"$ref": "#/$defs/nullableDigest"},
        "expected_trust_domain": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 300}, {"type": "null"}]},
        "minimum_final_version": {"$ref": "#/$defs/nullableInteger"},
        "anchor_source_errors": {"$ref": "#/$defs/errors"},
        "anchor_errors": {"$ref": "#/$defs/errors"},
        "expired_at_evaluation": {"type": "boolean"}
      }
    },
    "rootResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_index", "version", "root_sha256", "source_errors", "expired_at_evaluation", "not_yet_valid_at_evaluation"],
      "properties": {
        "root_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "version": {"$ref": "#/$defs/nullableInteger"},
        "root_sha256": {"$ref": "#/$defs/nullableDigest"},
        "source_errors": {"$ref": "#/$defs/errors"},
        "expired_at_evaluation": {"type": "boolean"},
        "not_yet_valid_at_evaluation": {"type": "boolean"}
      }
    },
    "algorithmTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_schemes", "candidate_schemes", "added_schemes", "removed_schemes"],
      "properties": {
        "previous_schemes": {"$ref": "#/$defs/schemeArray"},
        "candidate_schemes": {"$ref": "#/$defs/schemeArray"},
        "added_schemes": {"$ref": "#/$defs/schemeArray"},
        "removed_schemes": {"$ref": "#/$defs/schemeArray"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_index", "from_version", "to_version", "from_root_sha256", "to_root_sha256", "status", "source_errors", "trust_errors", "current_valid_root_signatures", "current_distinct_root_organizations", "previous_valid_root_signatures", "previous_distinct_root_organizations", "algorithm_transition"],
      "properties": {
        "transition_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "from_version": {"$ref": "#/$defs/nullableInteger"},
        "to_version": {"$ref": "#/$defs/nullableInteger"},
        "from_root_sha256": {"$ref": "#/$defs/nullableDigest"},
        "to_root_sha256": {"$ref": "#/$defs/nullableDigest"},
        "status": {"enum": ["trusted_rotation", "untrusted_bootstrap", "invalid_trust_evidence", "expired_trust_root", "not_yet_valid_trust_root", "rollback_detected", "version_gap_detected", "trust_discontinuity", "policy_not_authorized"]},
        "source_errors": {"$ref": "#/$defs/errors"},
        "trust_errors": {"$ref": "#/$defs/errors"},
        "current_valid_root_signatures": {"type": "integer", "minimum": 0, "maximum": 100},
        "current_distinct_root_organizations": {"type": "integer", "minimum": 0, "maximum": 100},
        "previous_valid_root_signatures": {"type": "integer", "minimum": 0, "maximum": 100},
        "previous_distinct_root_organizations": {"type": "integer", "minimum": 0, "maximum": 100},
        "algorithm_transition": {"$ref": "#/$defs/algorithmTransition"}
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_index", "policy_type", "policy_sha256", "status", "errors"],
      "properties": {
        "policy_index": {"type": "integer", "minimum": 0},
        "policy_type": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "policy_sha256": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "status": {"enum": ["authorized", "invalid_policy", "unauthorized_policy"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "anchor_version", "final_version", "roots_supplied", "root_limit", "transitions_required", "transitions_verified", "expired_intermediate_roots", "authorized_policies", "unauthorized_policies", "automatic_actions"],
      "properties": {
        "status": {"enum": ["trusted_chain", "untrusted_bootstrap", "invalid_chain_evidence", "expired_final_root", "not_yet_valid_final_root", "rollback_detected", "version_gap_detected", "trust_discontinuity", "final_version_not_reached", "policy_not_authorized"]},
        "anchor_version": {"$ref": "#/$defs/nullableInteger"},
        "final_version": {"$ref": "#/$defs/nullableInteger"},
        "roots_supplied": {"type": "integer", "minimum": 1, "maximum": 64},
        "root_limit": {"const": 64},
        "transitions_required": {"type": "integer", "minimum": 0, "maximum": 64},
        "transitions_verified": {"type": "integer", "minimum": 0, "maximum": 64},
        "expired_intermediate_roots": {"type": "integer", "minimum": 0, "maximum": 63},
        "authorized_policies": {"type": "integer", "minimum": 0, "maximum": 100},
        "unauthorized_policies": {"type": "integer", "minimum": 0, "maximum": 100},
        "automatic_actions": {"const": 0}
      }
    }
  }
}
