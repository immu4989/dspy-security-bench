{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/schemas/agentbom-mlbom-disclosure-report.schema.json",
  "title": "AgentBOM MLBOMDisclosure privacy-minimized gap report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "analyzer", "source_bom", "inventory", "mapping", "model_disclosure_coverage", "data_disclosure_coverage", "excluded_input_fields", "summary", "claim_boundary", "agentbom_claim_boundary", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AgentBOM MLBOMDisclosure / Privacy-minimized disclosure gap mapping"},
    "protocol_version": {"const": "agentbom-mlbom-disclosure-v1"},
    "analyzer": {"const": "deterministic-privacy-minimized-cyclonedx-mlbom-mapper-v1"},
    "source_bom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bom_format", "spec_version", "canonical_bom_sha256", "source_component_count", "model_component_count", "data_component_count"],
      "properties": {
        "bom_format": {"const": "CycloneDX"},
        "spec_version": {"const": "1.7"},
        "canonical_bom_sha256": {"$ref": "#/$defs/digest"},
        "source_component_count": {"type": "integer", "minimum": 1, "maximum": 2000},
        "model_component_count": {"type": "integer", "minimum": 1, "maximum": 500},
        "data_component_count": {"type": "integer", "minimum": 0, "maximum": 499}
      }
    },
    "inventory": {"$ref": "#/$defs/inventory"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_component_ids", "data_component_ids", "dependency_relationship_count", "dataset_relationship_count"],
      "properties": {
        "model_component_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_component_ids": {"type": "array", "maxItems": 499, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "dependency_relationship_count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "dataset_relationship_count": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "model_disclosure_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/modelCoverage"}
    },
    "data_disclosure_coverage": {
      "type": "array",
      "maxItems": 499,
      "items": {"$ref": "#/$defs/dataCoverage"}
    },
    "excluded_input_fields": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_components", "data_components", "disclosure_fields_expected", "disclosure_fields_present", "disclosure_gaps", "unresolved_dataset_references", "inventory_complete", "claim_binding_count", "raw_disclosure_values_retained", "source_signature_verified", "network_requests", "automatic_actions", "review_status"],
      "properties": {
        "model_components": {"type": "integer", "minimum": 1, "maximum": 500},
        "data_components": {"type": "integer", "minimum": 0, "maximum": 499},
        "disclosure_fields_expected": {"type": "integer", "minimum": 16, "maximum": 8000},
        "disclosure_fields_present": {"type": "integer", "minimum": 0, "maximum": 8000},
        "disclosure_gaps": {"type": "integer", "minimum": 0, "maximum": 8000},
        "unresolved_dataset_references": {"type": "integer", "minimum": 0, "maximum": 2000},
        "inventory_complete": {"const": false},
        "claim_binding_count": {"const": 0},
        "raw_disclosure_values_retained": {"const": false},
        "source_signature_verified": {"const": false},
        "network_requests": {"const": 0},
        "automatic_actions": {"const": 0},
        "review_status": {"const": "owner_review_required"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "agentbom_claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "modelField": {
      "enum": [
        "modelParameters.approach.type",
        "modelParameters.task",
        "modelParameters.architectureFamily",
        "modelParameters.modelArchitecture",
        "modelParameters.datasets",
        "modelParameters.inputs",
        "modelParameters.outputs",
        "quantitativeAnalysis.performanceMetrics",
        "quantitativeAnalysis.graphics",
        "considerations.users",
        "considerations.useCases",
        "considerations.technicalLimitations",
        "considerations.performanceTradeoffs",
        "considerations.ethicalConsiderations",
        "considerations.environmentalConsiderations",
        "considerations.fairnessAssessments"
      ]
    },
    "dataField": {"enum": ["contents", "classification", "sensitiveData", "graphics", "description", "governance"]},
    "modelCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "present_fields", "missing_fields", "present_count", "expected_count", "review_status"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "present_fields": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/modelField"}},
        "missing_fields": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/modelField"}},
        "present_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "expected_count": {"const": 16},
        "review_status": {"const": "owner_review_required"}
      }
    },
    "dataCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "present_fields", "missing_fields", "present_count", "expected_count", "review_status"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "present_fields": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/dataField"}},
        "missing_fields": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/dataField"}},
        "present_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "expected_count": {"const": 6},
        "review_status": {"const": "owner_review_required"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_type", "name", "version", "supplier", "digest", "locator", "criticality", "external"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "component_type": {"enum": ["model", "runtime", "framework", "library", "tool", "mcp-server", "policy", "dataset", "retrieval-index", "identity-provider", "trust-root", "container", "evaluator", "monitor", "infrastructure", "dependency"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "version": {"type": "string", "minLength": 1, "maxLength": 500},
        "supplier": {"type": "string", "minLength": 1, "maxLength": 500},
        "digest": {"$ref": "#/$defs/digest"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 500},
        "criticality": {"enum": ["critical", "high", "moderate", "low"]},
        "external": {"type": "boolean"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_component_id", "to_component_id", "relationship"],
      "properties": {
        "from_component_id": {"$ref": "#/$defs/id"},
        "to_component_id": {"$ref": "#/$defs/id"},
        "relationship": {"enum": ["depends-on", "uses", "authorized-by", "evaluated-by", "runs-on", "sourced-from", "monitored-by"]}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "inventory_type", "inventory_id", "title", "owner", "boundary", "complete", "components", "relationships", "required_claim_ids", "claim_bindings", "claim_boundary", "inventory_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "inventory_type": {"const": "dspy-security-bench-agentbom-inventory"},
        "inventory_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "owner": {"type": "string", "minLength": 1, "maxLength": 300},
        "boundary": {"type": "string", "minLength": 1, "maxLength": 1500},
        "complete": {"const": false},
        "components": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/component"}},
        "relationships": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/relationship"}},
        "required_claim_ids": {"type": "array", "maxItems": 0},
        "claim_bindings": {"type": "array", "maxItems": 0},
        "claim_boundary": {"type": "string", "minLength": 1},
        "inventory_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
