{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-policy.schema.json",
  "title": "AssuranceLedger v1 policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_type", "registry_id", "log_origin", "log_operator", "witnesses", "minimum_witnesses", "minimum_distinct_witness_organizations", "maximum_checkpoint_age_seconds", "claim_boundary", "policy_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_type": {"const": "dspy-security-bench-assurance-ledger-policy"},
    "registry_id": {"$ref": "#/$defs/id"},
    "log_origin": {"type": "string", "minLength": 1, "maxLength": 300},
    "log_operator": {"$ref": "#/$defs/key"},
    "witnesses": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/key"}},
    "minimum_witnesses": {"type": "integer", "minimum": 1, "maximum": 25},
    "minimum_distinct_witness_organizations": {"type": "integer", "minimum": 1, "maximum": 25},
    "maximum_checkpoint_age_seconds": {"type": "integer", "minimum": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "policy_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "organization_id", "public_key_spki_base64", "public_key_sha256"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/id"},
        "organization_id": {"$ref": "#/$defs/id"},
        "public_key_spki_base64": {"type": "string", "minLength": 1},
        "public_key_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
