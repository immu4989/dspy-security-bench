{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/schemas/evidencebridge.schema.json",
  "title": "CollectiveGuard EvidenceBridge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bridge_type", "bridge_version", "adapter_profile", "scenario_id", "title", "description", "collective_scenario", "sources", "observations", "evidence_policy", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "bridge_type": {"const": "dspy-security-bench-collective-evidence-bridge"},
    "bridge_version": {"const": "evidencebridge-v1"},
    "adapter_profile": {"enum": ["runtime-neutral-json", "otel-genai-development", "iam-decision-log", "network-policy-log", "siem-response-log"]},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 1200},
    "collective_scenario": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 100},
    "observations": {"type": "array", "maxItems": 30000},
    "evidence_policy": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
