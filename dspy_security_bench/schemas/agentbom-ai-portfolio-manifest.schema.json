{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-authored AI supplier portfolio manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "suppliers"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "manifest_type": {"const": "dspy-security-bench-ai-supplier-portfolio"},
    "suppliers": {
      "type": "array", "minItems": 1, "maxItems": 25,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["supplier_id", "cyclonedx_source", "spdx_source"],
        "properties": {
          "supplier_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
            "maxLength": 64,
            "not": {"enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]}
          },
          "cyclonedx_source": {"$ref": "#/$defs/path"},
          "spdx_source": {"$ref": "#/$defs/path"}
        }
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\u0000]+$"}
  }
}
