{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-root-view-interop-evidence.schema.json",
  "title": "AssuranceLedger RootViewInteropEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "statement", "claim_boundary", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AssuranceLedger RootViewInteropEvidence / Cross-implementation known-answer agreement"},
    "protocol_version": {"const": "assuranceledger-root-view-interop-evidence-v1"},
    "statement": {"$ref": "#/$defs/statement"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
    "status": {
      "enum": [
        "root_view_corroborated",
        "invalid_root_view_evidence",
        "root_view_policy_not_pinned",
        "root_view_request_mismatch",
        "insufficient_root_observers",
        "same_version_root_conflict",
        "newer_root_reported",
        "insufficient_root_observer_diversity",
        null
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {"sha256": {"$ref": "#/$defs/digest"}}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "language", "source_files"],
      "properties": {
        "implementation_id": {"$ref": "#/$defs/identifier"},
        "language": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]{0,49}$"},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_files": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "resultCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "expected_status", "observed_status", "verifier_accepted"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"const": "passed"},
        "expected_status": {"$ref": "#/$defs/status"},
        "observed_status": {"$ref": "#/$defs/status"},
        "verifier_accepted": {"type": "boolean"}
      }
    },
    "implementationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "implementation_sha256", "runtime", "vector_version", "manifest_sha256", "cases", "summary"],
      "properties": {
        "implementation": {"$ref": "#/$defs/identifier"},
        "implementation_sha256": {"$ref": "#/$defs/digest"},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 200},
        "vector_version": {"const": "assuranceledger-root-view-vectors-v1"},
        "manifest_sha256": {"const": "e39be2384f1ff8e49d8e62e26df112a01d181e5ece06a9e9f7df36dd93750e08"},
        "cases": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/resultCase"}},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "automatic_actions"],
          "properties": {"passed": {"const": 8}, "failed": {"const": 0}, "automatic_actions": {"const": 0}}
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "operation", "expected_status", "reference_observed_status", "external_observed_status", "expected_verifier_acceptance", "reference_verifier_accepted", "external_verifier_accepted", "agreement"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "operation": {"enum": ["evaluate", "verify-report"]},
        "expected_status": {"$ref": "#/$defs/status"},
        "reference_observed_status": {"$ref": "#/$defs/status"},
        "external_observed_status": {"$ref": "#/$defs/status"},
        "expected_verifier_acceptance": {"type": "boolean"},
        "reference_verifier_accepted": {"type": "boolean"},
        "external_verifier_accepted": {"type": "boolean"},
        "agreement": {"const": true}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_type", "subject", "predicateType", "predicate"],
      "properties": {
        "_type": {"const": "https://in-toto.io/Statement/v1"},
        "subject": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/subject"}},
        "predicateType": {"const": "https://immu4989.github.io/dspy-security-bench/attestations/root-view-interop-evidence/v1"},
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analyzer", "vector_version", "manifest_sha256", "implementations", "implementation_result", "case_agreements", "summary"],
          "properties": {
            "analyzer": {"const": "deterministic-root-view-interoperability-analyzer-v1"},
            "vector_version": {"const": "assuranceledger-root-view-vectors-v1"},
            "manifest_sha256": {"const": "e39be2384f1ff8e49d8e62e26df112a01d181e5ece06a9e9f7df36dd93750e08"},
            "implementations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/implementation"}},
            "implementation_result": {"$ref": "#/$defs/implementationResult"},
            "case_agreements": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/agreement"}},
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "implementation_count", "case_count", "agreement_count", "disagreement_count", "automatic_actions"],
              "properties": {
                "status": {"const": "interoperability_observed"},
                "implementation_count": {"const": 2},
                "case_count": {"const": 8},
                "agreement_count": {"const": 8},
                "disagreement_count": {"const": 0},
                "automatic_actions": {"const": 0}
              }
            }
          }
        }
      }
    }
  }
}
