{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/dspy_security_bench/schemas/assurance-exchange.schema.json",
  "title": "AssuranceGraph public reproduction exchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_type", "entries", "ranking_enabled", "automatic_endorsements", "claim_boundary", "registry_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_type": {"const": "dspy-security-bench-assurance-exchange"},
    "entries": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/entry"}},
    "ranking_enabled": {"const": false},
    "automatic_endorsements": {"const": 0},
    "claim_boundary": {"type": "string", "minLength": 1},
    "registry_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "profile_id", "sector", "report_sha256", "case_sha256", "source_repository", "source_revision", "report_url", "submitted_by", "disclosure", "status", "claim_outcomes", "evidence_kinds", "independent_reproductions", "updated_at", "known_gaps"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
        "profile_id": {"enum": ["enterprise-agent", "frontier-lab", "federal-high-impact", "critical-infrastructure"]},
        "sector": {"enum": ["cross-sector", "emergency-logistics", "financial-investigation", "healthcare-administration", "manufacturing-maintenance", "public-benefits", "software-development", "water-operations"]},
        "report_sha256": {"$ref": "#/$defs/digest"},
        "case_sha256": {"$ref": "#/$defs/digest"},
        "source_repository": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "report_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000},
        "submitted_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "disclosure": {"enum": ["synthetic", "sanitized-public"]},
        "status": {"enum": ["active", "stale", "withdrawn", "superseded"]},
        "claim_outcomes": {
          "type": "object", "additionalProperties": false,
          "required": ["supported", "violated", "contradicted", "stale_evidence", "missing_evidence"],
          "properties": {
            "supported": {"type": "integer", "minimum": 0},
            "violated": {"type": "integer", "minimum": 0},
            "contradicted": {"type": "integer", "minimum": 0},
            "stale_evidence": {"type": "integer", "minimum": 0},
            "missing_evidence": {"type": "integer", "minimum": 0}
          }
        },
        "evidence_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["authority", "collective-v2", "containment", "defense-portfolio", "dependency-impact", "schedule", "trace", "verified-defense"]}
        },
        "independent_reproductions": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/reproduction"}
        },
        "updated_at": {"type": "integer", "minimum": 0},
        "known_gaps": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reproduced_by", "report_sha256", "source_repository", "source_revision", "reproduced_at", "known_gap"],
      "properties": {
        "reproduced_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "report_sha256": {"$ref": "#/$defs/digest"},
        "source_repository": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "reproduced_at": {"type": "integer", "minimum": 0},
        "known_gap": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
