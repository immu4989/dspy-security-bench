{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/causal-submission.schema.json",
  "title": "CausalProof community submission bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_type", "submission", "structural_trace", "manifest", "causal_report", "schedule_report", "claim_boundary", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_type": {"const": "dspy-security-bench-causal-submission"},
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["submitter", "runtime", "source_repository", "created_at", "known_gaps"],
      "properties": {
        "submitter": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "created_at": {"type": "string", "format": "date"},
        "known_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    },
    "structural_trace": {
      "type": "object", "additionalProperties": false, "required": ["spans"],
      "properties": {"spans": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/span"}}}
    },
    "manifest": {"type": "object"},
    "causal_report": {"type": "object"},
    "schedule_report": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "otel_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_+/=-]+$"},
    "link": {
      "type": "object", "additionalProperties": false, "required": ["traceId", "spanId"],
      "properties": {"traceId": {"$ref": "#/$defs/otel_id"}, "spanId": {"$ref": "#/$defs/otel_id"}}
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["traceId", "spanId", "startTimeUnixNano", "endTimeUnixNano"],
      "properties": {
        "traceId": {"$ref": "#/$defs/otel_id"}, "spanId": {"$ref": "#/$defs/otel_id"},
        "parentSpanId": {"$ref": "#/$defs/otel_id"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "startTimeUnixNano": {"type": "string", "pattern": "^[0-9]+$"},
        "endTimeUnixNano": {"type": "string", "pattern": "^[0-9]+$"},
        "droppedAttributesCount": {"type": "integer", "minimum": 1}
      }
    }
  }
}
