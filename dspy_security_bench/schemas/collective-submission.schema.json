{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/schemas/collective-submission.schema.json",
  "title": "CollectiveGuard v2 community evidence submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_type", "submission", "scenario", "report", "claim_boundary", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_type": {"const": "dspy-security-bench-collective-submission"},
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["submitter", "runtime", "source_repository", "deployment_class", "created_at", "known_gaps"],
      "properties": {
        "submitter": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "deployment_class": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date"},
        "known_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    },
    "scenario": {"type": "object"}, "report": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
