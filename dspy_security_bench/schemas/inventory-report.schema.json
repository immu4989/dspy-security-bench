{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/inventory-report.schema.json",
  "title": "InventoryForge normalized public AI use-case report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "source_name", "source_sha256", "record_count", "records", "warnings", "disclaimer", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "InventoryForge / Public AI use-case normalization"},
    "source_name": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "record_count": {"type": "integer", "minimum": 1, "maximum": 5000},
    "records": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/record"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "disclaimer": {"type": "string", "minLength": 1},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_case_id", "name", "agency", "bureau", "summary", "topic", "classification", "stage", "source_url"],
      "properties": {
        "use_case_id": {"type": "string", "minLength": 1, "maxLength": 20000},
        "name": {"type": "string", "minLength": 1, "maxLength": 20000},
        "agency": {"type": "string", "minLength": 1, "maxLength": 20000},
        "bureau": {"type": "string", "maxLength": 20000},
        "summary": {"type": "string", "minLength": 1, "maxLength": 20000},
        "topic": {"type": "string", "maxLength": 20000},
        "classification": {"type": "string", "maxLength": 20000},
        "stage": {"type": "string", "maxLength": 20000},
        "source_url": {"type": "string", "maxLength": 20000}
      }
    }
  }
}
