{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assurancequorum-report.schema.json",
  "title": "AssuranceQuorum v1 report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "analyzer", "evaluation_time", "policy", "assurance_report", "review_envelopes", "review_results", "claim_results", "summary", "claim_boundary", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AssuranceQuorum / Role-separated assurance review evidence"},
    "protocol_version": {"const": "assurancequorum-v1"},
    "analyzer": {"const": "deterministic-role-separated-review-analyzer-v1"},
    "evaluation_time": {"type": "integer", "minimum": 0},
    "policy": {"$ref": "assurancequorum-policy.schema.json"},
    "assurance_report": {"type": "object"},
    "review_envelopes": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["payloadType", "payload", "signatures"],
        "properties": {
          "payloadType": {"const": "application/vnd.in-toto+json"},
          "payload": {"type": "string", "minLength": 1},
          "signatures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["keyid", "sig"], "properties": {"keyid": {"$ref": "#/$defs/digest"}, "sig": {"type": "string", "minLength": 1}}}}
        }
      }
    },
    "review_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "claim_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "claim_count", "claim_status_counts", "submitted_reviews", "valid_reviews", "invalid_reviews", "duplicate_signers", "evidence_gap_vetoes", "distinct_valid_signers", "automatic_deployment_actions", "automatic_risk_acceptances", "automatic_authorizations_to_operate"],
      "properties": {
        "status": {"enum": ["quorum_satisfied", "review_gap_recorded", "quorum_incomplete", "invalid_review_evidence"]},
        "claim_count": {"type": "integer"}, "claim_status_counts": {"type": "object"},
        "submitted_reviews": {"type": "integer"}, "valid_reviews": {"type": "integer"}, "invalid_reviews": {"type": "integer"},
        "duplicate_signers": {"type": "array", "items": {"type": "string"}}, "evidence_gap_vetoes": {"type": "integer"},
        "distinct_valid_signers": {"type": "integer"}, "automatic_deployment_actions": {"const": 0},
        "automatic_risk_acceptances": {"const": 0}, "automatic_authorizations_to_operate": {"const": 0}
      }
    },
    "claim_boundary": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
