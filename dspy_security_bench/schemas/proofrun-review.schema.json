{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/immu4989/dspy-security-bench/main/dspy_security_bench/schemas/proofrun-review.schema.json",
  "title": "ProofRun source-redacted review decision",
  "description": "A local review of one input snapshot, not a signed attestation or independent execution reproduction. Schema validation alone does not verify a verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_type", "verifier_version", "input_file_sha256", "bundle_type", "bundle_sha256", "integrity", "eligibility", "provenance", "evidence_tier", "policy", "review_is_attestation", "execution_reproduced", "exit_code", "verdict", "reason_code"],
  "properties": {
    "schema_version": {"const": 1},
    "review_type": {"const": "ProofRun verification"},
    "verifier_version": {"type": "string", "minLength": 1},
    "input_file_sha256": {"$ref": "#/$defs/nullableDigest"},
    "bundle_sha256": {"$ref": "#/$defs/nullableDigest"},
    "bundle_type": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/bundleType"}]},
    "integrity": {"enum": ["not_checked", "valid", "invalid"]},
    "eligibility": {"enum": ["not_checked", "eligible", "ineligible"]},
    "provenance": {"enum": ["not_checked", "verified", "unverified"]},
    "evidence_tier": {"enum": ["not_established", "self_attested", "github_attestation_unverified", "github_attested", "trusted_builder"]},
    "policy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/policy"}]},
    "review_is_attestation": {"const": false},
    "execution_reproduced": {"const": false},
    "exit_code": {"enum": [0, 1, 2]},
    "verdict": {"enum": ["pass", "not_eligible", "attestation_unverified", "invalid"]},
    "reason_code": {"enum": ["offline_verified", "online_verified", "not_eligible", "attestation_unverified", "invalid_policy", "invalid_input", "pin_mismatch", "unsupported_bundle_type", "invalid_evidence", "verification_error"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableDigest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "bundleType": {"enum": ["dspy-security-bench-community-submission", "dspy-security-bench-control-evidence-submission", "dspy-security-bench-incident-evidence-submission", "dspy-security-bench-source-evidence-submission", "dspy-security-bench-authority-evidence-submission"]},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_trials", "mode", "expected_file_sha256", "expected_repository_sha256", "require_trusted_builder", "deny_self_hosted_runner"],
      "properties": {
        "minimum_trials": {"type": "integer", "minimum": 2},
        "mode": {"enum": ["offline", "online"]},
        "expected_file_sha256": {"$ref": "#/$defs/nullableDigest"},
        "expected_repository_sha256": {"$ref": "#/$defs/nullableDigest", "description": "SHA-256 of the caller-supplied repository string's UTF-8 bytes, or null when derived from bundle claims. Informational policy fingerprint, not authentication."},
        "require_trusted_builder": {"type": "boolean"},
        "deny_self_hosted_runner": {"type": "boolean"}
      },
      "if": {"properties": {"mode": {"const": "offline"}}},
      "then": {"properties": {"require_trusted_builder": {"const": false}}}
    },
    "nativeValid": {
      "properties": {
        "input_file_sha256": {"$ref": "#/$defs/digest"},
        "bundle_sha256": {"$ref": "#/$defs/digest"},
        "bundle_type": {"$ref": "#/$defs/bundleType"},
        "integrity": {"const": "valid"},
        "policy": {"$ref": "#/$defs/policy"}
      }
    }
  },
  "oneOf": [
    {
      "allOf": [{"$ref": "#/$defs/nativeValid"}],
      "properties": {"verdict": {"const": "pass"}, "exit_code": {"const": 0}, "eligibility": {"const": "eligible"}, "reason_code": {"enum": ["offline_verified", "online_verified"]}}
    },
    {
      "allOf": [{"$ref": "#/$defs/nativeValid"}],
      "properties": {"verdict": {"const": "not_eligible"}, "exit_code": {"const": 1}, "eligibility": {"const": "ineligible"}, "provenance": {"const": "not_checked"}, "evidence_tier": {"enum": ["self_attested", "github_attestation_unverified"]}, "reason_code": {"const": "not_eligible"}}
    },
    {
      "allOf": [{"$ref": "#/$defs/nativeValid"}],
      "properties": {"verdict": {"const": "attestation_unverified"}, "exit_code": {"const": 1}, "eligibility": {"const": "eligible"}, "provenance": {"const": "unverified"}, "evidence_tier": {"enum": ["self_attested", "github_attestation_unverified"]}, "reason_code": {"const": "attestation_unverified"}, "policy": {"properties": {"mode": {"const": "online"}}}}
    },
    {
      "properties": {"verdict": {"const": "invalid"}, "exit_code": {"const": 2}, "integrity": {"enum": ["invalid", "not_checked"]}, "eligibility": {"const": "not_checked"}, "provenance": {"const": "not_checked"}, "evidence_tier": {"const": "not_established"}, "bundle_sha256": {"type": "null"}, "reason_code": {"enum": ["invalid_policy", "invalid_input", "pin_mismatch", "unsupported_bundle_type", "invalid_evidence", "verification_error"]}}
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"reason_code": {"const": "offline_verified"}}},
      "then": {"properties": {"provenance": {"const": "not_checked"}, "evidence_tier": {"enum": ["self_attested", "github_attestation_unverified"]}, "policy": {"properties": {"mode": {"const": "offline"}}}}}
    },
    {
      "if": {"properties": {"reason_code": {"const": "online_verified"}}},
      "then": {"properties": {"provenance": {"const": "verified"}, "evidence_tier": {"enum": ["github_attested", "trusted_builder"]}, "policy": {"properties": {"mode": {"const": "online"}}}}, "if": {"properties": {"policy": {"properties": {"require_trusted_builder": {"const": true}}}}}, "then": {"properties": {"evidence_tier": {"const": "trusted_builder"}}}}
    },
    {
      "if": {"properties": {"reason_code": {"const": "invalid_policy"}}},
      "then": {"properties": {"policy": {"type": "null"}}},
      "else": {"properties": {"policy": {"$ref": "#/$defs/policy"}}}
    },
    {
      "if": {"properties": {"reason_code": {"enum": ["invalid_policy", "invalid_input"]}}},
      "then": {"properties": {"input_file_sha256": {"type": "null"}, "bundle_type": {"type": "null"}, "integrity": {"const": "not_checked"}}}
    },
    {
      "if": {"properties": {"reason_code": {"enum": ["pin_mismatch", "unsupported_bundle_type"]}}},
      "then": {"properties": {"input_file_sha256": {"$ref": "#/$defs/digest"}, "bundle_type": {"type": "null"}, "integrity": {"const": "not_checked"}}}
    },
    {
      "if": {"properties": {"reason_code": {"enum": ["invalid_evidence", "verification_error"]}}},
      "then": {"properties": {"input_file_sha256": {"$ref": "#/$defs/digest"}, "bundle_type": {"$ref": "#/$defs/bundleType"}, "integrity": {"const": "invalid"}}}
    }
  ]
}
