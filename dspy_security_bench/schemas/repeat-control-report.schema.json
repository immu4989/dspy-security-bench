{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/immu4989/dspy-security-bench/main/dspy_security_bench/schemas/repeat-control-report.schema.json",
  "title": "DSPy Security Bench RepeatControlTwin Report",
  "description": "Repeated paired policy-off/policy-on functional evidence with fixed-suite uncertainty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "scenario_version", "protocol_sha256",
    "report_sha256", "agent", "policy", "confidence_level", "trial_isolation",
    "condition_schedule", "statistical_method", "inference_scope", "summary",
    "pair_summaries", "trials"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "RepeatControlTwin / Policy efficacy"},
    "scenario_version": {"const": "procurebench-v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent": {"type": "string", "minLength": 1},
    "policy": {"$ref": "#/$defs/policy"},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "trial_isolation": {"const": "fresh_agent_per_case_and_condition"},
    "condition_schedule": {"const": "alternating_baseline_first_controlled_first"},
    "statistical_method": {"const": "paired transitions with Wilson score intervals and exact McNemar test"},
    "inference_scope": {"type": "string", "minLength": 1},
    "summary": {"$ref": "#/$defs/summary"},
    "pair_summaries": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "#/$defs/pair_summary"}
    },
    "trials": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "document", "approval_handler", "arguments_captured"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document": {"type": "object"},
        "approval_handler": {"type": "string", "minLength": 1},
        "arguments_captured": {"type": "boolean"}
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes", "observations", "rate", "confidence_level",
        "interval_method", "lower", "upper", "sampling_unit"
      ],
      "properties": {
        "successes": {"type": "integer", "minimum": 0},
        "observations": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "interval_method": {"const": "wilson_score"},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "sampling_unit": {
          "enum": [
            "fixed_suite_pair_trial", "baseline_harmful_pair_trial",
            "baseline_harm_free_pair_trial", "baseline_failed_pair_trial",
            "baseline_clean_success_pair_trial", "contained_pair_trial"
          ]
        }
      }
    },
    "optional_rate": {
      "oneOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_reported_cases", "controlled_reported_cases", "cases_per_condition",
        "baseline_total_tokens", "controlled_total_tokens", "total_tokens_delta",
        "baseline_estimated_cost_usd", "controlled_estimated_cost_usd",
        "estimated_cost_delta_usd"
      ],
      "properties": {
        "baseline_reported_cases": {"type": "integer", "minimum": 0},
        "controlled_reported_cases": {"type": "integer", "minimum": 0},
        "cases_per_condition": {"type": "integer", "minimum": 20},
        "baseline_total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "controlled_total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens_delta": {"type": ["integer", "null"]},
        "baseline_estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "controlled_estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_delta_usd": {"type": ["number", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials", "pair_trials", "baseline_harm_free", "controlled_harm_free",
        "harm_containment_efficacy", "harm_introduction_rate",
        "controlled_attack_resistance", "safe_mission_recovery",
        "clean_utility_preservation", "recovery_gap_rate",
        "harm_prevented_pair_trials", "persistent_harm_pair_trials",
        "introduced_harm_pair_trials", "harm_free_both_pair_trials",
        "discordant_harm_pair_trials", "mcnemar_exact_two_sided_p", "unstable_pairs",
        "baseline_mean_synthetic_funds_at_risk_usd",
        "controlled_mean_synthetic_funds_at_risk_usd",
        "mean_synthetic_funds_risk_reduction_usd", "policy_decisions", "calls_blocked",
        "approvals_requested", "approvals_granted", "elapsed_seconds", "usage"
      ],
      "properties": {
        "trials": {"type": "integer", "minimum": 2},
        "pair_trials": {"type": "integer", "minimum": 10},
        "baseline_harm_free": {"$ref": "#/$defs/rate"},
        "controlled_harm_free": {"$ref": "#/$defs/rate"},
        "harm_containment_efficacy": {"$ref": "#/$defs/optional_rate"},
        "harm_introduction_rate": {"$ref": "#/$defs/optional_rate"},
        "controlled_attack_resistance": {"$ref": "#/$defs/rate"},
        "safe_mission_recovery": {"$ref": "#/$defs/optional_rate"},
        "clean_utility_preservation": {"$ref": "#/$defs/optional_rate"},
        "recovery_gap_rate": {"$ref": "#/$defs/optional_rate"},
        "harm_prevented_pair_trials": {"type": "integer", "minimum": 0},
        "persistent_harm_pair_trials": {"type": "integer", "minimum": 0},
        "introduced_harm_pair_trials": {"type": "integer", "minimum": 0},
        "harm_free_both_pair_trials": {"type": "integer", "minimum": 0},
        "discordant_harm_pair_trials": {"type": "integer", "minimum": 0},
        "mcnemar_exact_two_sided_p": {"type": "number", "minimum": 0, "maximum": 1},
        "unstable_pairs": {"type": "integer", "minimum": 0, "maximum": 5},
        "baseline_mean_synthetic_funds_at_risk_usd": {"type": "number", "minimum": 0},
        "controlled_mean_synthetic_funds_at_risk_usd": {"type": "number", "minimum": 0},
        "mean_synthetic_funds_risk_reduction_usd": {"type": "number", "minimum": 0},
        "policy_decisions": {"type": "integer", "minimum": 0},
        "calls_blocked": {"type": "integer", "minimum": 0},
        "approvals_requested": {"type": "integer", "minimum": 0},
        "approvals_granted": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "pair_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id", "title", "attack_kind", "baseline_harm_free", "controlled_harm_free",
        "harm_containment_efficacy", "harm_introduction_rate",
        "controlled_attack_resistance", "safe_mission_recovery",
        "clean_utility_preservation", "recovery_gap_rate", "effect_outcome_counts",
        "distinct_effect_outcomes", "stable_effect", "residual_harm_trials",
        "clean_regression_trials"
      ],
      "properties": {
        "pair_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "attack_kind": {"type": "string", "minLength": 1},
        "baseline_harm_free": {"$ref": "#/$defs/rate"},
        "controlled_harm_free": {"$ref": "#/$defs/rate"},
        "harm_containment_efficacy": {"$ref": "#/$defs/optional_rate"},
        "harm_introduction_rate": {"$ref": "#/$defs/optional_rate"},
        "controlled_attack_resistance": {"$ref": "#/$defs/rate"},
        "safe_mission_recovery": {"$ref": "#/$defs/optional_rate"},
        "clean_utility_preservation": {"$ref": "#/$defs/optional_rate"},
        "recovery_gap_rate": {"$ref": "#/$defs/optional_rate"},
        "effect_outcome_counts": {
          "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "distinct_effect_outcomes": {"type": "integer", "minimum": 1},
        "stable_effect": {"type": "boolean"},
        "residual_harm_trials": {"type": "integer", "minimum": 0},
        "clean_regression_trials": {"type": "integer", "minimum": 0}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_number", "execution_order", "control"],
      "properties": {
        "trial_number": {"type": "integer", "minimum": 1},
        "execution_order": {"enum": ["baseline_first", "controlled_first"]},
        "control": {"$ref": "control-report.schema.json"}
      }
    }
  }
}
