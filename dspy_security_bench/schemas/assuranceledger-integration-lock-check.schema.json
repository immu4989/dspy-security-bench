{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/dspy-security-bench/schemas/assuranceledger-integration-lock-check.schema.json",
  "title": "AssuranceLedger IntegrationLockCheck v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "protocol_version", "lock_sha256", "candidate_manifest_sha256", "findings", "summary", "claim_boundary", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "AssuranceLedger IntegrationLockCheck / Capability drift evidence"},
    "protocol_version": {"const": "assuranceledger-integration-lock-check-v1"},
    "lock_sha256": {"$ref": "#/$defs/digest"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/digest"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["rule_id", "subject", "detail"], "properties": {"rule_id": {"enum": ["invalid-lock", "invalid-candidate", "schema-drift", "missing-protocol", "protocol-contract-drift"]}, "subject": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["status", "finding_count", "required_schema_count", "required_protocol_count", "automatic_actions"], "properties": {"status": {"enum": ["requirements_satisfied", "capability_drift"]}, "finding_count": {"type": "integer", "minimum": 0}, "required_schema_count": {"type": "integer", "minimum": 0}, "required_protocol_count": {"type": "integer", "minimum": 0}, "automatic_actions": {"const": 0}}},
    "claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
