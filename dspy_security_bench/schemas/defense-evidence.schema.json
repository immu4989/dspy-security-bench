{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/dspy-security-bench/schemas/defense-evidence.schema.json",
  "title": "Verified Cyber Defense Commons evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_type", "submission", "mission", "proposal", "report", "claim_boundary", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_type": {"const": "dspy-security-bench-defense-evidence"},
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submitter", "runtime", "source_repository", "deployment_class", "created_at", "disclosure_status", "known_gaps", "raw_data_shared"],
      "properties": {
        "submitter": {"type": "string", "minLength": 1, "maxLength": 200},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_repository": {"type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
        "deployment_class": {"type": "string", "minLength": 1, "maxLength": 200},
        "created_at": {"type": "string", "format": "date"},
        "disclosure_status": {"enum": ["public-pattern", "embargoed", "private"]},
        "known_gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "raw_data_shared": {"const": false}
      }
    },
    "mission": {
      "type": "object",
      "required": ["mission_type", "mission_id", "mission_sha256"],
      "properties": {
        "mission_type": {"const": "dspy-security-bench-defense-mission"},
        "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$"},
        "mission_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposal": {
      "type": "object",
      "required": ["proposal_type", "proposal_id", "proposal_sha256"],
      "properties": {
        "proposal_type": {"const": "dspy-security-bench-remediation-proposal"},
        "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "report": {
      "type": "object",
      "required": ["report_type", "report_sha256", "mission_sha256", "proposal_sha256", "summary"],
      "properties": {
        "report_type": {"const": "DefenderTwin / Verified cyber-defense remediation assurance"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "mission_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "summary": {
          "type": "object",
          "required": ["outcome", "evidence_complete", "content_fields_processed"],
          "properties": {
            "outcome": {"enum": ["effective_and_safe", "effective_with_regression", "ineffective", "insufficient_evidence"]},
            "evidence_complete": {"type": "boolean"},
            "content_fields_processed": {"const": 0}
          }
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
